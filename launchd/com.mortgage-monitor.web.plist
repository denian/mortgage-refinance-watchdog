<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mortgage-monitor.web</string>

  <key>ProgramArguments</key>
  <array>
    <string>__INSTALL_DIR__/.venv/bin/uvicorn</string>
    <string>web.app:app</string>
    <string>--host</string>
    <string>0.0.0.0</string>
    <string>--port</string>
    <string>8080</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__INSTALL_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__INSTALL_DIR__/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>__INSTALL_DIR__/logs/web.log</string>

  <key>StandardErrorPath</key>
  <string>__INSTALL_DIR__/logs/web.error.log</string>

  <!-- Start automatically at login and restart on crash -->
  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
