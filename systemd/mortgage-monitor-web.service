[Unit]
Description=Mortgage Monitor Web UI (FastAPI)
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
ExecStart=__INSTALL_DIR__/.venv/bin/uvicorn web.app:app --host 0.0.0.0 --port 9090
EnvironmentFile=__INSTALL_DIR__/.env
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mortgage-monitor-web

[Install]
WantedBy=multi-user.target
